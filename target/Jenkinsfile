pipeline {

    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    environment {
        TOMCAT_HOME = "/opt/tomcat"
    }

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Chaitalipatil27/Hostel-Management.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Deploy') {
            steps {
                sh 'cp target/*.war $TOMCAT_HOME/webapps/'
            }
        }

        stage('Restart Tomcat') {
            steps {
                sh '$TOMCAT_HOME/bin/shutdown.sh || true'
                sh '$TOMCAT_HOME/bin/startup.sh'
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful'
        }

        failure {
            echo 'Deployment Failed'
        }
    }
}
